# Grievance360 Environment Configuration (Example)
# Copy this file to .env and fill in your values. Never commit real credentials.

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/grievance360
SPRING_DATASOURCE_USERNAME=grievance360
SPRING_DATASOURCE_PASSWORD=change_me

# Server Configuration
SERVER_PORT=8080

# Spring Profiles
SPRING_PROFILES_ACTIVE=dev
